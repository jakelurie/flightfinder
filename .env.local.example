# Copy to .env.local and adjust. Restart the server after changing.
# No API keys are required.

# Flight data: google (default) = real fares read from Google Flights in a local headless Chrome.
#              demo = simulated fares, serpapi = SerpApi (needs SERPAPI_API_KEY).
FLIGHT_PROVIDER=google
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome   # only if Chrome isn't found
# GOOGLE_MAX_PAGES=3

# AI: uses the logged-in `claude` CLI (your Claude subscription) automatically.
# LLM_PROVIDER=claude-cli   # or: anthropic (needs ANTHROPIC_API_KEY), none (rule-based)
# CLAUDE_MODEL=opus         # or sonnet for faster answers
# ANTHROPIC_API_KEY=
# SERPAPI_API_KEY=

# Your home airport(s), first = primary. Nearby alternates are searched too.
DEFAULT_ORIGINS=SFO,OAK,SJC

# Max flight/explore searches per analysis. Keep this modest: Google may CAPTCHA heavy use.
SEARCH_MAX_PROVIDER_CALLS=30
# SEARCH_CONCURRENCY=4
# CACHE_TTL_HOURS=6
